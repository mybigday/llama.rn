codec.cpp does not compile with libc++ (clang): std::fill and std::atoi are
used without including <algorithm> / <cstdlib>. GCC and Apple clang accept
this through transitive includes; libc++ does not. Found while building the
C++ test suite with clang (tests/build_and_test.sh).

--- a/src/lm/lm.cpp
+++ b/src/lm/lm.cpp
@@ -1,4 +1,5 @@
 #include "lm_internal.h"
+#include <algorithm>
 #include "speaker_chatterbox.h"
 #include "speaker_qwen3_tts.h"
 
