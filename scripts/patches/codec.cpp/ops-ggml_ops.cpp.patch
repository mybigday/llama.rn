ggml removed ggml_diag_mask_inf (llama.cpp #29801). Add codec_op_diag_mask_inf,
which applies the same causal mask as an additive mask.
--- a/src/ops/ggml_ops.cpp
+++ b/src/ops/ggml_ops.cpp
@@ -217,6 +217,32 @@
     const int64_t ne[1] = {n};
     ggml_tensor * t = codec_graph_const(ctx, name, GGML_TYPE_F32, 1, ne, v.data());
     return t != nullptr ? t : native;
+}
+
+ggml_tensor * codec_op_diag_mask_inf(ggml_context * ctx, ggml_tensor * a, int32_t n_past) {
+    if (ctx == nullptr || a == nullptr || n_past < 0) return nullptr;
+    const int64_t n_k = a->ne[0];
+    const int64_t n_q = a->ne[1];
+
+    std::vector<float> m((size_t) (n_k * n_q));
+    for (int64_t q = 0; q < n_q; ++q) {
+        for (int64_t k = 0; k < n_k; ++k) {
+            m[(size_t) (q * n_k + k)] = k > q + n_past ? -INFINITY : 0.0f;
+        }
+    }
+    const std::string name = "lut.diag_mask." + std::to_string(n_k) + "." + std::to_string(n_q) + "." +
+                             std::to_string(n_past);
+    const int64_t ne[2] = {n_k, n_q};
+    ggml_tensor * mask = codec_graph_const(ctx, name.c_str(), GGML_TYPE_F32, 2, ne, m.data());
+    if (mask == nullptr) {  // no graph build to hold the mask constant
+        ggml_tensor * tmpl = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_k, n_q);
+        ggml_tensor * k_idx = ggml_repeat(ctx, ggml_reshape_2d(ctx, codec_op_arange(ctx, 0.0f, (float) n_k, 1.0f), n_k, 1), tmpl);
+        ggml_tensor * q_idx = ggml_repeat(ctx, ggml_reshape_2d(ctx, codec_op_arange(ctx, 0.0f, (float) n_q, 1.0f), 1, n_q), tmpl);
+        // 1 where k - q - n_past > 0 (masked), else 0
+        ggml_tensor * diff = ggml_scale_bias(ctx, ggml_sub(ctx, k_idx, q_idx), 1.0f, (float) -n_past);
+        mask = ggml_scale(ctx, ggml_clamp(ctx, diff, 0.0f, 1.0f), -1e30f);
+    }
+    return ggml_add(ctx, a, mask);
 }
 
