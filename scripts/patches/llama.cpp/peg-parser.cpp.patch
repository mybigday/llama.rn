+common_json common_peg_arena::to_json() const {
+    auto parsers = common_json::array();
+    for (const auto & parser : parsers_) {
+        parsers.push_back(serialize_parser_variant(parser));
+    }
+    return common_json{
+        {"parsers", parsers},
+        {"rules", rules_},
+        {"root", root_}
+    };
+}
